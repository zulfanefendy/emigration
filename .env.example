# Salin jadi .env lalu isi nilainya:  cp .env.example .env
# File .env TIDAK boleh di-commit.

# Koneksi Postgres lokal kamu sendiri (bukan database server).
# Contoh: postgresql://postgres:password@localhost:5432/emigration
DATABASE_URL=

# Akun admin awal yang dibuat oleh `npx prisma db seed`
SEED_ADMIN_EMAIL=admin@lokal.test
SEED_ADMIN_PASSWORD=

# Kunci tanda tangan cookie sesi (min. 32 karakter acak).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
